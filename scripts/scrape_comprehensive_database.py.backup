    def create_database_schema(self):
        """Create database schema for ROM database"""
        conn = sqlite3.connect(self.database_path)
        cursor = conn.cursor()
        
        # Create platforms table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS platforms (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE,
                manufacturer TEXT,
                generation TEXT,
                release_year INTEGER,
                media_type TEXT,
                source TEXT,
                last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        
        # Create roms table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS roms (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                description TEXT,
                size INTEGER,
                crc32 TEXT,
                md5 TEXT,
                sha1 TEXT,
                platform_id INTEGER,
                region TEXT,
                languages TEXT,
                version TEXT,
                serial TEXT,
                edition TEXT,
                source TEXT,
                dat_file TEXT,
                last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (platform_id) REFERENCES platforms (id),
                UNIQUE(crc32, md5, sha1, platform_id)
            )
        ''')
        
        # Create indexes for performance
        cursor.execute('CREATE INDEX IF NOT EXISTS idx_roms_crc32 ON roms(crc32)')
        cursor.execute('CREATE INDEX IF NOT EXISTS idx_roms_md5 ON roms(md5)')
        cursor.execute('CREATE INDEX IF NOT EXISTS idx_roms_sha1 ON roms(sha1)')
        cursor.execute('CREATE INDEX IF NOT EXISTS idx_roms_platform ON roms(platform_id)')
        cursor.execute('CREATE INDEX IF NOT EXISTS idx_roms_name ON roms(name)')
        
        conn.commit()
        conn.close()
        
        logger.info("Database schema created")
    
    def download_dat_file(self, url: str, destination: str) -> bool:
        """Download a DAT file from URL"""
        try:
            logger.info(f"Downloading DAT file from {url}")
            response = requests.get(url, timeout=30)
            response.raise_for_status()
            
            with open(destination, 'wb') as f:
                f.write(response.content)
            
            self.stats['dat_files_downloaded'] += 1
            logger.info(f"Downloaded {destination}")
            return True
            
        except Exception as e:
            logger.error(f"Failed to download {url}: {e}")
            self.stats['errors'] += 1
            return False
    
    def parse_no_intro_dat(self, dat_path: str, platform: str) -> List[ROMEntry]:
        """Parse No-Intro DAT file (XML format)"""
        roms = []
        try:
            tree = ET.parse(dat_path)
            root = tree.getroot()
            
            for game in root.findall('.//game'):
                name = game.get('name', '')
                description = game.findtext('description', '')
                
                # Get ROM information
                rom_element = game.find('rom')
                if rom_element is not None:
                    size = int(rom_element.get('size', 0))
                    crc32 = rom_element.get('crc', '').lower()
                    md5 = rom_element.get('md5', '').lower()
                    sha1 = rom_element.get('sha1', '').lower()
                    
                    rom_entry = ROMEntry(
                        name=name,
                        description=description,
                        size=size,
                        crc32=crc32,
                        md5=md5,
                        sha1=sha1,
                        platform=platform,
                        region='',  # Would need to parse from name/description
                        languages='',
                        version='',
                        serial='',
                        edition='',
                        source='no-intro',
                        dat_file=os.path.basename(dat_path),
                        last_updated=datetime.now().isoformat()
                    )
                    roms.append(rom_entry)
                
                logger.info(f"Parsed {len(roms)} ROMs from {dat_path}")
                
            except Exception as e:
                logger.error(f"Failed to parse Redump DAT {dat_path}: {e}")
                self.stats['errors'] += 1
            
            return roms
        
        def parse_tosec_dat(self, dat_path: str, platform: str) -> List[ROMEntry]:
            """Parse TOSEC DAT file"""
            roms = []
            try:
                logger.info(f"Would parse TOSEC DAT: {dat_path}")
                
                # Simulate some ROMs
                for i in range(3):
                    rom_entry = ROMEntry(
                        name=f"TOSEC Game {i}",
                        description=f"TOSEC game for {platform}",
                        size=1024 * 1024 * (i + 1),  # 1MB to 3MB
                        crc32=f"tosec_crc_{i:08x}",
                        md5=f"tosec_md5_{i:032x}",
                        sha1=f"tosec_sha1_{i:040x}",
                        platform=platform,
                        region="Multiple",
                        languages="en",
                        version="1.0",
                        serial=f"TOSEC-{i:06d}",
                        edition="TOSEC",
                        source='tosec',
                        dat_file=os.path.basename(dat_path),
                        last_updated=datetime.now().isoformat()
                    )
                    roms.append(rom_entry)
                
                logger.info(f"Parsed {len(roms)} ROMs from {dat_path}")
                
            except Exception as e:
                logger.error(f"Failed to parse TOSEC DAT {dat_path}: {e}")
                self.stats['errors'] += 1
            
            return roms
        
        def parse_mame_dat(self, dat_path: str, platform: str) -> List[ROMEntry]:
            """Parse MAME DAT file"""
            roms = []
            try:
                logger.info(f"Would parse MAME DAT: {dat_path}")
                
                # Simulate some ROMs
                for i in range(8):
                    rom_entry = ROMEntry(
                        name=f"MAME Game {i}",
                        description=f"MAME arcade game for {platform}",
                        size=1024 * 1024 * (i + 5),  # 5MB to 12MB
                        crc32=f"mame_crc_{i:08x}",
                        md5=f"mame_md5_{i:032x}",
                        sha1=f"mame_sha1_{i:040x}",
                        platform=platform,
                        region="World",
                        languages="en",
                        version="1.0",
                        serial=f"MAME-{i:06d}",
                        edition="MAME",
                        source='mame',
                        dat_file=os.path.basename(dat_path),
                        last_updated=datetime.now().isoformat()
                    )
                    roms.append(rom_entry)
                
                logger.info(f"Parsed {len(roms)} ROMs from {dat_path}")
                
            except Exception as e:
                logger.error(f"Failed to parse MAME DAT {dat_path}: {e}")
                self.stats['errors'] += 1
            
            return roms
        
        def parse_libretro_dat(self, dat_path: str, platform: str) -> List[ROMEntry]:
            """Parse libretro DAT file"""
            roms = []
            try:
                logger.info(f"Parsing libretro DAT: {dat_path}")
                
                # Simple parsing of libretro DAT format
                with open(dat_path, 'r', encoding='utf-8') as f:
                    lines = f.readlines()
                
                for line in lines:
                    line = line.strip()
                    if line and not line.startswith('#'):
                        # Simple parsing - in reality would need proper parsing
                        parts = line.split(' ')
                        if len(parts) >= 2:
                            name = ' '.join(parts[1:])
                            crc = parts[0] if len(parts[0]) == 8 else ''
                            
                            rom_entry = ROMEntry(
                                name=name,
                                description=f"Libretro game for {platform}",
                                size=1024 * 1024,  # 1MB default
                                crc32=crc,
                                md5='',
                                sha1='',
                                platform=platform,
                                region='',
                                languages='',
                                version='',
                                serial='',
                                edition='',
                                source='libretro',
                                dat_file=os.path.basename(dat_path),
                                last_updated=datetime.now().isoformat()
                            )
                            roms.append(rom_entry)
                
                logger.info(f"Parsed {len(roms)} ROMs from {dat_path}")
                
            except Exception as e:
                logger.error(f"Failed to parse libretro DAT {dat_path}: {e}")
                self.stats['errors'] += 1
            
            return roms
        
        def save_roms_to_database(self, roms: List[ROMEntry]):
            """Save ROM entries to database"""
            if not roms:
                return
            
            conn = sqlite3.connect(self.database_path)
            cursor = conn.cursor()
            
            saved_count = 0
            platform = roms[0].platform if roms else ''
            
            # First, ensure platform exists
            cursor.execute('INSERT OR IGNORE INTO platforms (name, source) VALUES (?, ?)',
                          (platform, roms[0].source if roms else ''))
            
            # Get platform ID
            cursor.execute('SELECT id FROM platforms WHERE name = ?', (platform,))
            platform_result = cursor.fetchone()
            platform_id = platform_result[0] if platform_result else 1
            
            # Insert ROMs
            for rom in roms:
                try:
                    cursor.execute('''
                        INSERT OR IGNORE INTO roms
                        (name, description, size, crc32, md5, sha1, platform_id, region,
                         languages, version, serial, edition, source, dat_file, last_updated)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    ''', (
                        rom.name, rom.description, rom.size, rom.crc32, rom.md5, rom.sha1,
                        platform_id, rom.region, rom.languages, rom.version, rom.serial,
                        rom.edition, rom.source, rom.dat_file, rom.last_updated
                    ))
                    
                    if cursor.rowcount > 0:
                        saved_count += 1
                        
                except Exception as e:
                    logger.error(f"Failed to save ROM {rom.name}: {e}")
                    self.stats['errors'] += 1
            
            conn.commit()
            conn.close()
            
            self.stats['roms_processed'] += saved_count
            logger.info(f"Saved {saved_count} ROMs for {platform}")
        
        def scrape_source(self, source_key: str, source_info: Dict):
            """Scrape a specific source"""
            logger.info(f"Scraping {source_info['name']}...")
            
            # Special handling for libretro database
            if source_key == 'libretro':
                self.scrape_libretro_database(source_info)
                return
            
            # Create temporary directory for DAT files
            with tempfile.TemporaryDirectory() as temp_dir:
                # For now, we'll simulate downloading and parsing
                # In a real implementation, we would download actual DAT files
                
                logger.info(f"Would download DAT files from: {source_info['dat_urls']}")
                
                # Simulate processing each platform
                for platform in source_info['platforms']:
                    logger.info(f"  Processing {platform}...")
                    
                    # In a real implementation, we would:
                    # 1. Download the DAT file for this platform
                    # 2. Parse it based on source format
                    # 3. Save to database
                    
                    # For now, just update stats
                    self.stats['platforms_found'] += 1
                    
                    # Simulate some ROM entries based on source
                    if source_key == 'no-intro':
                        simulated_roms = self.parse_no_intro_dat('', platform)
                    elif source_key == 'redump':
                        simulated_roms = self.parse_redump_dat('', platform)
                    elif source_key == 'tosec':
                        simulated_roms = self.parse_tosec_dat('', platform)
                    elif source_key == 'mame':
                        simulated_roms = self.parse_mame_dat('', platform)
                    else:
                        simulated_roms = []
                    
                    # Save to database
                    self.save_roms_to_database(simulated_roms)
            
            logger.info(f"Finished scraping {source_info['name']}")
        
        def scrape_libretro_database(self, source_info: Dict):
            """Scrape libretro-database directory"""
            logger.info("Scraping libretro-database...")
            
            local_path = source_info.get('local_path', 'libretro-database')
            if not os.path.exists(local_path):
                logger.error(f"libretro-database directory not found: {local_path}")
                return
            
            # Find all DAT files
            dat_files = []
            for root, dirs, files in os.walk(local_path):
                for file in files:
                    if file.endswith('.dat'):
                        dat_files.append(os.path.join(root, file))
            
            logger.info(f"Found {len(dat_files)} DAT files in libretro-database")
            
            # Process each DAT file
            for dat_file in dat_files:
                try:
                    # Extract platform name from path
                    platform = os.path.basename(os.path.dirname(dat_file))
                    if not platform:
                        platform = os.path.basename(dat_file).replace('.dat', '')
                    
                    # Parse DAT file
                    roms = self.parse_libretro_dat(dat_file, platform)
                    
                    # Save to database
                    self.save_roms_to_database(roms)
                    
                    self.stats['platforms_found'] += 1
                    
                except Exception as e:
                    logger.error(f"Failed to process {dat_file}: {e}")
                    self.stats['errors'] += 1
            
            # Update source info with found platforms
            platforms_found = set()
            for dat_file in dat_files:
                platform = os.path.basename(os.path.dirname(dat_file))
                if platform:
                    platforms_found.add(platform)
            
            source_info['platforms'] = list(platforms_found)
            logger.info(f"Found {len(platforms_found)} platforms in libretro-database")
        
        def run(self):
            """Run comprehensive scraper"""
            logger.info("Starting comprehensive ROM database scraper")
            logger.info(f"Database: {self.database_path}")
            
            # Create database schema
            self.create_database_schema()
            
            # Scrape each source
            for source_key, source_info in self.sources.items():
                self.scrape_source(source_key, source_info)
            
            # Print statistics
            self.print_statistics()
        
        def print_statistics(self):
            """Print scraping statistics"""
            end_time = datetime.now()
            duration = end_time - self.stats['start_time']
            
            # Get database stats
            conn = sqlite3.connect(self.database_path)
            cursor = conn.cursor()
            
            cursor.execute('SELECT COUNT(*) FROM platforms')
            platform_count = cursor.fetchone()[0]
            
            cursor.execute('SELECT COUNT(*) FROM roms')
            rom_count = cursor.fetchone()[0]
            
            conn.close()
            
            print("\n" + "=" * 70)
            print("COMPREHENSIVE ROM DATABASE SCRAPER - STATISTICS")
            print("=" * 70)
            print(f"Duration: {duration}")
            print(f"Platforms found: {platform_count}")
            print(f"ROMs processed: {rom_count}")
            print(f"Errors: {self.stats['errors']}")
            print("\nSources scraped:")
            for source_key, source_info in self.sources.items():
                platform_count_for_source = len(source_info.get('platforms', []))
                print(f"  - {source_info['name']}: {platform_count_for_source} platforms")
            print("=" * 70)
    
    def main():
        """Main function"""
        import argparse
        
        parser = argparse.ArgumentParser(description='Comprehensive ROM Database Scraper')
        parser.add_argument('--database', '-d', default='instance/romarr.db',
                           help='Path to SQLite database (default: instance/romarr.db)')
        parser.add_argument('--skip-libretro', action='store_true',
                           help='Skip libretro-database scraping')
        
        args = parser.parse_args()
        
        # Create scraper instance
        scraper = ComprehensiveDatabaseScraper(database_path=args.database)
        
        # Skip libretro if requested
        if args.skip_libretro:
            del scraper.sources['libretro']
            logger.info("Skipping libretro-database as requested")
        
        # Run scraper
        try:
            scraper.run()
            logger.info("Scraping completed successfully")
        except Exception as e:
            logger.error(f"Scraping failed: {e}")
            sys.exit(1)
    
    if __name__ == '__main__':
        main()
            
            logger.info(f"Parsed {len(roms)} ROMs from {dat_path}")
            
        except Exception as e:
            logger.error(f"Failed to parse No-Intro DAT {dat_path}: {e}")
            self.stats['errors'] += 1
        
        return roms
    
    def parse_redump_dat(self, dat_path: str, platform: str) -> List[ROMEntry]:
        """Parse Redump DAT file (text format)"""
        roms = []
        try:
            with open(dat_path, 'r', encoding='utf-8') as f:
                content = f.read()
            
            # Redump DAT format parsing would go here
            # For now, simulate some entries
            logger.info(f"Would parse Redump DAT: {dat_path}")
            
            # Simulate some ROMs
            for i in range(5):
                rom_entry = ROMEntry(
                    name=f"Redump Game {i}",
                    description=f"Redump game for {platform}",
                    size=1024 * 1024 * (i + 2),  # 2MB to 6MB
                    crc32=f"redump_crc_{i:08x}",
                    md5=f"redump_md5_{i:032x}",
                    sha1=f"redump_sha1_{i:040x}",
                    platform=platform,
                    region="EUR",
                    languages="en,fr,de",
                    version="1.0",
                    serial=f"REDUMP-{i:06d}",
                    edition="Redump",
                    source='redump',
                    dat_file=os.path.basename(dat_path),
                    last_updated=datetime.now().isoformat()
                )
                roms.append(rom_entry)
