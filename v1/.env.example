# Romerr Configuration
# Copy this file to .env and update the values

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
DATABASE_URL=sqlite:///gamerr.db

# Prowlarr Configuration
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your-prowlarr-api-key-here

# qBittorrent Configuration
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# ROMs Path Configuration
ROMS_PATH=/data/roms

# Docker Configuration (for docker-compose)
# These will be set automatically in docker-compose.yml